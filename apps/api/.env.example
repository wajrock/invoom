# Postgres (docker compose locally; the Northflank addon in production)
DATABASE_URL=postgres://invoom:invoom@localhost:5432/invoom
# Optional credentials overriding those of DATABASE_URL. On Northflank, use the addon's
# ADMIN_USERNAME / ADMIN_PASSWORD: the POSTGRES_URI user can't create the migrations schema.
# DATABASE_USER=
# DATABASE_PASSWORD=

# Master AES-256 key, base64 (32 bytes): pnpm --filter @invoom/api gen-key
# Never change it once data exists: workspace keys are encrypted with it.
ENCRYPTION_KEY=

# Outgoing email (sign-up and recovery links). Without SMTP_URL, emails are printed to the console.
# Locally, docker compose runs Mailpit (inbox at http://localhost:8025):
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Invoom <no-reply@localhost>

PORT=3333
# Set to true behind a reverse proxy (reads X-Forwarded-For)
TRUST_PROXY=false
