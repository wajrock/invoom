{
    "name": "@invoom/api",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env src/main.ts",
        "dev:tunnel": "node --watch --env-file-if-exists=.env src/main.ts",
        "start": "node src/main.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --test 'src/**/*.test.ts'",
        "db:generate": "drizzle-kit generate",
        "access-link": "node --env-file-if-exists=.env scripts/access-link.ts",
        "gen-key": "node -e \"console.log(require('node:crypto').randomBytes(32).toString('base64'))\""
    },
    "dependencies": {
        "@hono/node-server": "^2.1.6",
        "@simplewebauthn/server": "^14.0.3",
        "drizzle-orm": "^0.45.4",
        "hono": "^4.13.16",
        "nodemailer": "^10.3.1",
        "pdfkit": "^0.17.2",
        "postgres": "^3.4.9",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/nodemailer": "^8.0.2",
        "@types/pdfkit": "^0.17.7",
        "drizzle-kit": "^0.31.11",
        "typescript": "~6.0.3"
    }
}
