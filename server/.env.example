# URL Postgres (fournie par l'addon Northflank en production)
DATABASE_URL=postgres://freelance:freelance@localhost:5432/freelance
# Optionnel : identifiants qui remplacent ceux de DATABASE_URL (Northflank : ADMIN_USERNAME / ADMIN_PASSWORD de l'addon,
# car l'utilisateur de POSTGRES_URI ne peut pas créer le schéma des migrations)
# DATABASE_USER=
# DATABASE_PASSWORD=
# Clé AES-256 en base64 (32 octets) : pnpm gen-key
ENCRYPTION_KEY=
# Empreinte argon2 du code d'accès : pnpm hash-code
ACCESS_CODE_HASH=
# Port HTTP
PORT=3333
# Mettre "true" derrière le proxy Northflank (lecture de X-Forwarded-For)
TRUST_PROXY=false
# Dossier du build Angular servi en production
STATIC_DIR=../client/dist/client/browser
