{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "bracketSpacing": false,
    "trailingComma": "all",
    "arrowParens": "always",
    "endOfLine": "lf",
    "overrides": [
        {"files": "*.html", "options": {"parser": "angular"}},
        {"files": ["*.yml", "*.yaml"], "options": {"tabWidth": 2}}
    ]
}
